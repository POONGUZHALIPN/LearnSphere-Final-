{
  "name": "learnsphere-app",
  "version": "3.0.1",
  "description": "LearnSphere — Vite frontend with Node.js backend and clean routing.",
  "main": "server.js",
  "scripts": {
    "dev": "node dev-server.js",
    "start": "node server.js",
    "api": "node server.js",
